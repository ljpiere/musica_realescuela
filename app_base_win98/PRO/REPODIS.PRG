SET EXACT OFF
SELECT 2
ZAP
SELECT 1
SET PRINT ON
SET CONSOLE OFF
SET DEVICE TO PRINT
STORE "REPORTE INDIVIDUAL DE "+V1 TO LINEA2
STORE TRIM(V0) TO V0
STORE V0 TO LINEA3
STORE 62 TO LIN
STORE .F. TO SWLINE
STORE 0 TO CONTPAG
STORE .T. TO SW1
DO WHILE SW1
 STORE TITULO     TO TTITULO
 STORE INTERPRETE TO TINTERPRETE
 STORE ORQUESTA   TO TORQUESTA
 STORE CODIGO     TO TCODIGO 
 SELECT 2
 APPEND BLANK
 REPLACE TITULO     WITH TTITULO
 REPLACE INTERPRETE WITH TINTERPRETE
 REPLACE ORQUESTA   WITH TORQUESTA
 REPLACE CODIGO     WITH TCODIGO 
 SELECT 1
 IF .NOT. EOF()
  SKIP
 ELSE
  EXIT
 ENDIF
 IF &V1<>V0
  SW1=.F.  
 ENDIF
ENDDO 
SELECT 2
IF OPCION=2
 INDEX ON INTERPRETE TO \DBASE\ARCHIVOS\WORK
ELSE
 INDEX ON TITULO TO \DBASE\ARCHIVOS\WORK
ENDIF
DO WHILE .NOT. EOF()
 IF LIN>61
  IF SWLINE
   EJECT
  ELSE
   STORE .T. TO SWLINE
  ENDIF
  CONTPAG=CONTPAG+1
  @ 1,0 SAY CHR(18)
  @ 1,6 SAY "Pag. No "+STR(CONTPAG,3,0)+SPACE(45)+"Fecha "+DTOC(FECHA)
  @ 2,(80-LEN(LINEA2))/2 SAY LINEA2  
  @ 3,(80-LEN(LINEA3))/2 SAY LINEA3
  @ 4,0 SAY CHR(15)
  @ 4,1 SAY REPLICATE("*",132)  
  IF OPCION=2
   @ 5,25 SAY V2+SPACE(28)+V3+SPACE(23)+"GAVETA"+SPACE(2)+"DISCO"+SPACE(2)+"TEMA"
  ELSE
   @ 5,25 SAY V2+SPACE(28)+V3+SPACE(27)+"GAVETA"+SPACE(2)+"DISCO"+SPACE(2)+"TEMA"
  ENDIF
  @ 6,1 SAY REPLICATE("*",132)  
  STORE 7 TO LIN
 ENDIF
 @ LIN,21 SAY &V2
 @ LIN,57 SAY &V3
 @ LIN,95 SAY SUBSTR(CODIGO,1,2)
 @ LIN,103 SAY SUBSTR(CODIGO,4,2)
 @ LIN,109 SAY SUBSTR(CODIGO,7,2)
 LIN=LIN+1
 IF EOF()
  EXIT
 ELSE
  SKIP
 ENDIF  
ENDDO
EJECT
SET CONSOLE ON
SET PRINT OFF
SET DEVICE TO SCREEN
SELECT 1
SET EXACT ON
RETURN
