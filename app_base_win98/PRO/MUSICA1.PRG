*PROGRAMA MUSICA
TAG=.T.
 STORE "ARCHIVO MAESTRO DE DISCOS" TO HEADING
 STORE 28 TO LIN
DO WHILE TAG
 OPCION=0
 CLEAR
 @  2, 26  SAY "OPCIONES  PARA EL MANEJO DEL"
 @  3, LIN SAY HEADING
 @  6, 30  SAY "1.NUEVOS TITULOS"
 @  8, 30  SAY "2.MODIFICAR TITULOS"
 @ 10, 30  SAY "3.ELIMINAR TITULOS"
 @ 12, 30  SAY "4.MENU PRINCIPAL"
 @ 15, 35  SAY "OPCION:" GET OPCION PICTURE "#" RANGE 1,5
 @ 14, 25  TO 14, 55
 @  0, 21  TO 17, 59    DOUBLE
 @  1, 24  TO  4, 56    DOUBLE
 @  5, 24  TO 16, 56    DOUBLE
 READ
 DO CASE
  CASE OPCION=1
       DO NUEVO1
  CASE OPCION=2
       DO EDITAR1
  CASE OPCION=3
       DO ANULAR1
  OTHERWISE
  CLEAR
   STORE " " TO ORDEN
   @ 12,26 SAY "Ordenar Archivos (S/N):  ( )"
   @ 12,52 GET ORDEN PICTURE "!"
   READ
   @ 12,1 SAY SPACE(60)
   IF ORDEN="S"
    @ 23,2 say "El proceso de salida termina al volver al men£ ppal. un momento por favor.."
    USE DISCOS
    INDEX ON CODIGO TO DCODIGO
    INDEX ON TITULO TO DCANCION
    INDEX ON INTERPRETE TO DCANTA
    INDEX ON ORQUESTA TO DTOCA
   ENDIF
   TAG=.F.
 ENDCASE
ENDDO
CLOSE DATABASES
SET EXACT OFF
RETURN

