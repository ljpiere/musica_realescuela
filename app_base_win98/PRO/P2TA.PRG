CLEAR
CLOSE ALL
SET STATUS OFF
SET CONFIRM ON
SET BELL OFF
SET ECHO OFF
SET TALK OFF
SET SCOREBOARD OFF
SET ESCAPE OFF
SET SAFETY OFF
SET EXACT ON
PUBLIC ALL
STORE .T. TO TT
DO WHILE TT
CLEAR
O=0
@  3, 27  SAY "MENU   DE   TANGOLANDIA"
@  7, 28  SAY "1. MANEJO ARCHIVO MAESTRO"
@  9, 28  SAY "2. CONSULTAS POR PANTALLA"
@ 11, 28  SAY "3. REPORTES PERIODICOS"
@ 13, 28  SAY "4. CONTAR TANGOLANDIA"
@ 15, 28  SAY "5. SALIR DEL SISTEMA"
@ 19, 35  SAY "OPCION:" GET O PICTURE "9" RANGE 1,5
@  2, 25  TO  4, 55    DOUBLE
@  5, 25  TO 20, 55    DOUBLE
@ 17, 26  TO 17, 54
@  0, 23  TO 22, 57    DOUBLE
READ
DO CASE
 CASE O=1
      DO TAMUSICA
 CASE O=2
      DO TATITULO
 CASE O=3
      DO TAINFORM
 CASE O=4
      DO CONTARTA
 CASE O=5
      DO P2
 ENDCASE
ENDDO
DO P2
