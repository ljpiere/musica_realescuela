*PROGRAMA NUEVO1
*PROGRAMA PARA EL REGISTRO DE NUEVAS CANCIONES
TAG1=.T.
REVISOR=.T.
USE DISCOS INDEX DCODIGO
DO WHILE TAG1
IF REVISOR
CLEAR
TCASETE=SPACE(8)
@  8, 15  TO 19, 63    DOUBLE
@  5, 15  TO  7, 63
@  6, 27  SAY "CREACION DE NUEVOS DISCOS"
@ 10, 18  SAY "Codigo......"
@ 10, 30  GET  TCASETE  PICTURE "@!"
READ
CORRECTO=" "
@ 18,30 SAY "CORRECTO (S/N):" GET CORRECTO PICTURE "A"
READ
@ 18,30 SAY "                 "
IF UPPER(CORRECTO)<>"S"
 LOOP
ENDIF
FIND &TCASETE
IF .NOT. EOF()
 @ 18,1 SAY "El Codigo Digitado ya Existe !"
 WAIT " " TO W
 @ 18,1 SAY "                               "
 LOOP
ENDIF
APPEND BLANK
REPLACE DISCOS->CODIGO WITH TCASETE
ENDIF
@ 10, 18  SAY "Codigo......"
@ 10, 30  GET  DISCOS->CODIGO
CLEAR GETS
@ 12, 18  SAY "Titulo......"
@ 12, 30  GET  DISCOS->TITULO  PICTURE  "@!"
@ 14, 18  SAY "Interprete.."
@ 14, 30  GET  DISCOS->INTERPRETE PICTURE "@!"
@ 16, 18  SAY "Autor......."
@ 16, 30  GET DISCOS->AUTOR   PICTURE  "@!"
@ 18, 18  SAY "Orquesta...."
@ 18, 30  GET DISCOS->ORQUESTA PICTURE  "@!"
READ
CORRECTO=" "
@ 20,30 SAY "CORRECTO (S/N):" GET CORRECTO PICTURE "A"
READ
@ 20,30 SAY "                 "
IF UPPER(CORRECTO)="S"
 MAS=" "
 @ 20,30 SAY "CONTINUA (S/N):" GET MAS PICTURE "A"
 READ
 @ 20,30 SAY "                  "
 IF UPPER(MAS)="S"
  REVISOR=.T.
 ELSE
  EXIT
 ENDIF
ELSE
 REVISOR=.F.
ENDIF
ENDDO
RETURN

