@23,2 SAY " "
?? INKEY(2)
CLEAR
USE
SELECT 2
USE WORK
SELECT 1
USE DISCOS
TT=.T.
DO WHILE TT
 OPCION=0
 CLEAR
 @  2, 26  SAY "MENU  DE  REPORTES DISCOS"
 @  5, 29  SAY "1. GENERAL ALFABETICO"
 @  7, 29  SAY "2. INDIVIDUAL TITULO"
 @  9, 29  SAY "3. INDIVIDUAL INTERPRETE"
 @ 11, 29  SAY "4. INDIVIDUAL ORQUESTA"
 @ 13, 29  SAY "5. MENU PRINCIPAL"
 @ 16, 37  SAY "OPCION:" GET OPCION PICTURE "9" RANGE 1,5
 @  1, 24  TO  3, 58    DOUBLE
 @  4, 24  TO 17, 58    DOUBLE
 @  0, 22  TO 18, 60    DOUBLE
 @ 15, 25  TO 15, 57  
 READ
 IF  OPCION<>5
  PI=0
  CLEAR
  @ 10,25 SAY ":1: PANTALLA     :2: IMPRESORA"
  @ 11,25 SAY "              " GET  PI PICTURE "#" RANGE 1,2
  @ 9,23 TO 12,57 DOUBLE
  READ
  IF PI=2
   CLEAR
   @ 15,22 SAY "Aliste su impresora y presione ENTER."
   @ 14,20 TO 16, 58
   WAIT " " TO W
  ENDIF
 ENDIF
 DO CASE
  CASE OPCION=1
   SET INDEX TO DCANCION
   CLEAR
   IF PI=1
    REPORT FORM DISCOS1
   ELSE
    SET CONSOLE OFF
    SET PRINT ON
    ?CHR(27)+CHR(15)
    ?CHR(27)+CHR(82)+"12"
    REPORT FORM DISCOS TO PRINT
    SET PRINT OFF
    SET CONSOLE ON
   ENDIF
  CASE OPCION=2
   CLEAR
   V0=SPACE (32)
   @ 13, 19  SAY "TITULO DESEADO: " GET V0 PICTURE "@!"
   @ 11, 13 TO 15, 67   DOUBLE
   READ
   IF V0=SPACE(32)
    LOOP
   ENDIF
   V0=TRIM(V0)
   CLOSE INDEX
   SET INDEX TO DCANCION
   FIND  &V0
   IF .NOT. EOF()
    CLEAR
    IF PI=1
     REPORT FORM DISCOS1 FOR TITULO=V0
    ELSE
     STORE "TITULO" TO V1
     STORE "INTERPRETE" TO V2
     STORE "ORQUESTA" TO V3
     DO REPODIS
    ENDIF
   ELSE
    IF PI=2
     SET CONSOLE ON
     SET PRINT OFF
     SET DEVICE TO SCREEN
    ENDIF
    @ 22, 2 SAY "El titulo solicitado no se encuentra registrado..."
    ??INKEY(3)
    @ 22, 2 CLEAR
   ENDIF
  CASE OPCION=3
   CLEAR
   V0=SPACE (25)
   @ 13, 17  SAY "INTERPRETE DESEADO: " GET V0 PICTURE "@!"
   @ 11, 13 TO 15, 67   DOUBLE
   READ
   IF V0=SPACE(32)
    LOOP
   ENDIF
   CLOSE INDEX
   SET INDEX TO DCANTA
   FIND  &V0
   IF .NOT. EOF()
    CLEAR
    IF PI=1
     REPORT FORM DISCOS1 FOR INTERPRETE=V0
    ELSE
     STORE "INTERPRETE" TO V1
     STORE "TITULO" TO V2
     STORE "ORQUESTA" TO V3
     DO REPODIS
    ENDIF
   ELSE
    IF PI=2
     SET CONSOLE ON
     SET PRINT OFF
     SET DEVICE TO SCREEN
    ENDIF
    @ 22, 2 SAY "El interprete solicitado no se encuentra registrado..."
    ??INKEY(3)
    @ 22, 2 CLEAR
   ENDIF
  CASE OPCION=4
   CLEAR
   V0=SPACE(32)
   @ 11, 13 TO 15, 67   DOUBLE
   @ 13, 16  SAY "ORQUESTA DESEADA: " GET V0
   READ
   IF V0=SPACE(32)
    LOOP
   ENDIF
   CLOSE INDEX
   SET INDEX TO DTOCA
   FIND &V0
   IF .NOT. EOF()
    CLEAR
    IF PI=1
     REPORT FORM DISCOS1 FOR ORQUESTA=V0
    ELSE
     STORE "ORQUESTA" TO V1
     STORE "TITULO" TO V2
     STORE "INTERPRETE" TO V3
     DO REPODIS
    ENDIF
   ELSE
    IF PI=2
     SET CONSOLE ON
     SET PRINT OFF
     SET DEVICE TO SCREEN
    ENDIF
    @ 22, 2 SAY "La orquesta solicitada no se encuentra registrada..."
    ??INKEY(3)
    @ 22, 2 CLEAR
   ENDIF
  OTHERWISE
   EXIT
 ENDCASE
ENDDO
CLOSE DATABASES
RETURN
