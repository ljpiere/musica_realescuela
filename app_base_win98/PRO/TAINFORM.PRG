CLEA
STORE CTOD("  /  /  ") TO FECHA
@ 11,17 TO 16,62 DOUBLE
SET COLOR TO I
@ 12,19 SAY " Digite a continuaci¢n la fecha actual en "
@ 13,19 SAY "            formato mes/dia/a¤o           "
SET COLOR TO
@ 15,36 GET FECHA
READ
IF DTOC(FECHA)="  /  /  "
 RETURN
ENDIF
@23,2 SAY " "
?? INKEY(2)
CLEAR
USE
SELECT 2
USE WORK1
SELECT 1
USE CATANGOS
TT=.T.
DO WHILE TT
OPCION=0
CLEAR
@  2, 26  SAY "MENU REPORTES TANGOLANDIA"
@  5, 29  SAY "1. GENERAL POR CODIGO"
@  7, 29  SAY "2. GENERAL ALFABETICO"
@  9, 29  SAY "3. INDIVIDUAL TITULO"
@ 11, 29  SAY "4. INDIVIDUAL INTERPRETE"
@ 13, 29  SAY "5. INDIVIDUAL ORQUESTA"
@ 15, 29  SAY "6. INDIVIDUAL CASSETTE"
@ 17, 29  SAY "7. MENU PRINCIPAL"
@ 20, 37  SAY "OPCION:" GET OPCION PICTURE "9" RANGE 1,7
@  1, 24  TO  3, 58    DOUBLE
@  4, 24  TO 21, 58    DOUBLE
@  0, 22  TO 22, 60    DOUBLE
@ 19, 25  TO 19, 57
READ
IF  OPCION<>7
 PI=0
 CLEAR
 @ 10,25 SAY ":1: PANTALLA     :2: IMPRESORA"
 @ 11,25 SAY "              " GET  PI PICTURE "#" RANGE 1,2
 @ 9,23 TO 12,57 DOUBLE
 READ
 IF PI=2
  @ 15,22 SAY "Aliste su impresora y presione ENTER."
  @ 14,20 TO 16, 58
  WAIT " " TO W
  SET PRINT ON
 ENDIF
ENDIF
DO CASE
 CASE OPCION=1
  IF PI=2
   ??CHR(15)
  ENDIF
  CLEAR
  USE CATANGOS INDEX TCODIGO
  STORE SPACE (9) TO TCOD1,TCOD2
  @ 10,15 SAY "CODIGO INICIAL DEL REPORTE:" GET TCOD1
  @ 12,15 SAY "CODIGO FINAL DEL REPORTE  :" GET TCOD2
  READ
  CLEAR
  IF TCOD1=" ".AND.TCOD2=" "
   IF PI=1
    REPORT FORM TACASSET
   ELSE
    SET CONSOLE OFF
    REPORT FORM TACASSET TO PRINT
   ENDIF
  ELSE
   IF TCOD1=" "
    IF PI=1
     REPORT FORM TACASSET FOR CASETE<=TCOD2
    ELSE
     SET CONSOLE OFF
     REPORT FORM TACASSEA FOR CASETE<=TCOD2 TO PRINT
    ENDIF
   ELSE
    IF TCOD2=" "
     IF PI=1
      REPORT FORM TACASSET FOR CASETE>=TCOD1
     ELSE
      SET CONSOLE OFF
      REPORT FORM TACASSEA FOR CASETE>=TCOD1 TO PRINT
     ENDIF
    ELSE
     IF PI=1
      REPORT FORM TACASSET FOR CASETE>=TCOD1.AND.CASETE<=TCOD2
     ELSE
      SET CONSOLE OFF
      REPORT FORM TACASSEA FOR CASETE>=TCOD1.AND.CASETE<=TCOD2 TO PRINT
     ENDIF
    ENDIF
   ENDIF
  ENDIF
  WAIT " PRESIONE ENTER " TO W
 CASE OPCION=2
  USE CATANGOS INDEX TCANCION
  CLEAR
  IF PI=1
   REPORT FORM TACASSET
  ELSE
   SET CONSOLE OFF
   ??CHR(15)
   REPORT FORM TACASSET TO PRINT
  ENDIF
  WAIT "Presione ENTER"
 CASE OPCION=3
  CLEAR
  V0=SPACE (32)
  @ 13, 19  SAY "TITULO DESEADO: " GET V0 PICTURE  "@!"
  @ 11, 13 TO 15, 67   DOUBLE
  READ
  IF V0=SPACE(32)
   LOOP
  ENDIF
  V0=TRIM(V0)
  CLOSE INDEX
  SET INDEX TO TCANCION
  FIND  &V0
  IF .NOT. EOF()
   CLEAR
   IF PI=1
    REPORT FORM TACASSE1 FOR TITULO=V0
   ELSE
    STORE "TITULO" TO V1
    STORE "INTERPRETE" TO V2
    STORE "ORQUESTA" TO V3
    STORE "INTERPRETE" TO V21
    STORE "ORQUESTA  " TO V31
    STORE "AUTOR" TO V4
    DO REPOCAS
   ENDIF
  ELSE
   IF PI=2
    SET CONSOLE ON
    SET PRINT OFF
    SET DEVICE TO SCREEN
   ENDIF
   @ 22, 2 SAY "El titulo solicitado no se encuentra registrado..."
   ??INKEY(3)
   @ 22, 2 CLEAR
  ENDIF
 CASE OPCION=4
  CLEAR
  V0=SPACE (25)
  @ 13, 17  SAY "INTERPRETE DESEADO: " GET V0 PICTURE "@!"
  @ 11, 13 TO 15, 67   DOUBLE
  READ
  IF V0=SPACE(25)
   LOOP
  ENDIF
  CLOSE INDEX
  SET INDEX TO TCANTA
  FIND  &V0
  IF .NOT. EOF()
   CLEAR
   IF PI=1
    REPORT FORM TACASSE2 FOR INTERPRETE=V0
   ELSE
    STORE "INTERPRETE" TO V1
    STORE "TITULO" TO V2
    STORE "ORQUESTA" TO V3
    STORE "TITULO    " TO V21
    STORE "ORQUESTA  " TO V31
    STORE "AUTOR" TO V4
    DO REPOCAS
   ENDIF
  ELSE
   IF PI=2
    SET CONSOLE ON
    SET PRINT OFF
    SET DEVICE TO SCREEN
   ENDIF
   @ 22, 2 SAY "El interprete solicitado no se encuentra registrado..."
   ??INKEY(3)
   @ 22, 2 CLEAR
  ENDIF
 CASE OPCION=5
  CLEAR
  V0=SPACE(25)
  @ 11, 13 TO 15, 67   DOUBLE
  @ 13, 16  SAY "ORQUESTA DESEADA: " GET V0
  READ
  IF V0=SPACE(25)
   LOOP
  ENDIF
  CLOSE INDEX
  SET INDEX TO TTOCA
  FIND &V0
  IF .NOT. EOF()
   CLEAR
   IF PI=1
    REPORT FORM TACASSE3 FOR ORQUESTA=V0
   ELSE
    STORE "ORQUESTA" TO V1
    STORE "TITULO" TO V2
    STORE "INTERPRETE" TO V3
    STORE "TITULO    " TO V21
    STORE "INTERPRETE" TO V31
    STORE "AUTOR" TO V4
    DO REPOCAS
   ENDIF
  ELSE
   IF PI=2
    SET CONSOLE ON
    SET PRINT OFF
    SET DEVICE TO SCREEN
   ENDIF
   @ 22, 2 SAY "La orquesta soliicitada no se encuentra registrada..."
   ??INKEY(3)
   @ 22, 2 CLEAR
  ENDIF
 CASE OPCION=6
  CLEAR
  TCOD=SPACE(3)
  @ 11, 13 TO 15, 67   DOUBLE
  @ 13, 25  SAY "CASSETTE DESEADO: " GET TCOD
  READ
  STORE "cassette" TO LITERAL
  USE CATANGOS
  SET INDEX TO TCODIGO
  @ 16, 27 SAY "Un momento por favor..."
  LOCATE FOR SUBSTR(CASETE,1,3)=TCOD
  IF .NOT. EOF()
   CLEAR
   IF PI=1
    REPORT FORM TACASSET FOR SUBSTR(CASETE,1,3)=TCOD
   ELSE
    SET CONSOLE OFF
    ??CHR(15)
    REPORT FORM TACASSEA FOR SUBSTR(CASETE,1,3)=TCOD TO PRINT
   ENDIF
  ELSE
   @ 22, 2 SAY "El "
   ?? LITERAL+" "+"solicitado no se encuentra registrado... Presione ENTER."
   WAIT " " TO W
   @ 22, 2 SAY "                                                                          "
  ENDIF
 OTHERWISE
  TT=.F.
ENDCASE
ENDDO
CLOSE DATABASES
RETURN
