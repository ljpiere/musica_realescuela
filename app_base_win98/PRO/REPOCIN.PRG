SET EXACT OFF
SELECT 2
ZAP
SELECT 1
SET PRINT ON
SET CONSOLE OFF
SET DEVICE TO PRINT
STORE "REPORTE INDIVIDUAL DE "+V1 TO LINEA2
STORE TRIM(V0) TO V0
STORE V0 TO LINEA3
STORE 62 TO LIN
STORE .F. TO SWLINE
STORE 0 TO CONTPAG
STORE .T. TO SW1
DO WHILE SW1
 STORE TITULO     TO TTITULO
 STORE INTERPRETE TO TINTERPRETE
 STORE ORQUESTA   TO TORQUESTA
 STORE AUTOR      TO TAUTOR 
 STORE CASETE     TO TCODIGO 
 SELECT 2
 APPEND BLANK
 REPLACE TITULO     WITH TTITULO
 REPLACE INTERPRETE WITH TINTERPRETE
 REPLACE ORQUESTA   WITH TORQUESTA
 REPLACE AUTOR      WITH TAUTOR
 REPLACE CASETE     WITH TCODIGO 
 SELECT 1
 IF .NOT. EOF()
  SKIP
 ELSE
  EXIT
 ENDIF
 IF &V1<>V0
  SW1=.F.  
 ENDIF
ENDDO 
SELECT 2
IF OPCION=3
 INDEX ON INTERPRETE TO \DBASE\ARCHIVOS\WORK1
ELSE
 INDEX ON TITULO TO \DBASE\ARCHIVOS\WORK1
ENDIF
DO WHILE .NOT. EOF()
 IF LIN>61
  IF SWLINE
   EJECT
  ELSE
   STORE .T. TO SWLINE
  ENDIF
  CONTPAG=CONTPAG+1
  @ 1,0 SAY CHR(18)
  @ 1,6 SAY "Pag. No "+STR(CONTPAG,3,0)+SPACE(45)+"Fecha "+DTOC(FECHA)
  @ 2,(80-LEN(LINEA2))/2 SAY LINEA2  
  @ 3,(80-LEN(LINEA3))/2 SAY LINEA3
  @ 4,0 SAY CHR(15)
  @ 4,1 SAY REPLICATE("*",132)  
  @ 5,15 SAY V21+SPACE(23)+V31+SPACE(22)+V4+SPACE(18)+"CASSETTE"+SPACE(3)+"LADO"+SPACE(3)+"TEMA"
  @ 6,1 SAY REPLICATE("*",132)  
  STORE 7 TO LIN
 ENDIF
 @ LIN,5   SAY &V2
 @ LIN,41  SAY &V3
 @ LIN,71  SAY &V4
 @ LIN,106 SAY SUBSTR(CASETE,1,3)
 @ LIN,115 SAY SUBSTR(CASETE,5,1)
 @ LIN,122 SAY SUBSTR(CASETE,7,3)
 LIN=LIN+1
 IF EOF()
  EXIT
 ELSE
  SKIP
 ENDIF  
ENDDO
EJECT
SET CONSOLE ON
SET PRINT OFF
SET DEVICE TO SCREEN
SELECT 1
SET EXACT ON
RETURN
