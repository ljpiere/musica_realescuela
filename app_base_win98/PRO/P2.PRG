CLEAR
CLOSE ALL
SET STATUS OFF
SET CONFIRM ON
SET BELL OFF
SET ECHO OFF
SET TALK OFF
SET SCOREBOARD OFF
SET ESCAPE OFF
SET SAFETY OFF
SET EXACT ON
*SET PATH TO a:
PUBLIC ALL
STORE .T. TO TT
DO WHILE TT
   CLEAR
   O=0
   @  3, 32  SAY "MENU DE SELECCIONES"
   @  7, 28  SAY "1. V A R I O S "
*   @  7, 28  SAY "1. BOLEROS/OTROS"
   @  9, 28  SAY "2. ANTIGUEDADES"
   @ 11, 28  SAY "3. SALIR DEL SISTEMA"
   *@ 13, 28  SAY "4. CURIOSIDADES"
   *@ 15, 28  SAY "5. SALIR DEL SISTEMA"
   @ 15, 35  SAY "OPCION:" GET O PICTURE "9" RANGE 1,5
   @  2, 25  TO  4, 55    DOUBLE
   @  5, 25  TO 16, 55    DOUBLE
   @ 13, 26  TO 13, 54
   @  0, 23  TO 18, 57    DOUBLE
   READ
   DO CASE
      CASE O=1
           DO P2CA
      CASE O=2
           DO P2BO
      CASE O=3
           DO P0
      *CASE O=4
      *     DO P2CU
      *CASE O=5
      *     DO P0
   ENDCASE
ENDDO
DO P0
