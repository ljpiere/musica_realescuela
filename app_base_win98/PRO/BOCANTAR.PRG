PARAMETERS OPCION1
STORE SPACE(32) TO TIT
STORE SPACE(25) TO INT,AUT,ORQ
STORE SPACE(3)  TO NUMERO
STORE SPACE(2)  TO CANCION
STORE SPACE(1)  TO LADO
STORE "NO REGISTRADO" TO NADA
IF  BOLEROS->TITULO=" "
 TIT=NADA
ELSE
 TIT=BOLEROS->TITULO
ENDIF
IF  BOLEROS->INTERPRETE=" "
 INT=NADA
ELSE
 INT=BOLEROS->INTERPRETE
ENDIF
IF  BOLEROS->AUTOR=" "
 AUT=NADA
ELSE
 AUT=BOLEROS->AUTOR
ENDIF
IF  BOLEROS->ORQUESTA=" "
 ORQ=NADA
ELSE
 ORQ=BOLEROS->ORQUESTA
ENDIF
NUMERO=SUBSTR(BOLEROS->CASETE,1,3)
LADO=SUBSTR(BOLEROS->CASETE,5,1)
CANCION=SUBSTR(BOLEROS->CASETE,7,2)
CLEAR
DO CASE
CASE OPCION1=1
@  3, 13  TO 20, 66    DOUBLE
@ 13, 16  TO 18, 63
@ 15, 17  TO 15, 62
@  1, 16  SAY "REGISTRO Y LOCALIZACION DE BOLEROS"
@  5, 16  SAY "Titulo.........."
@  5, 32  SAY  TIT
@  7, 16  SAY "Interprete......"
@  7, 32  GET  INT
CLEAR GETS
@  9, 16  SAY "Autor..........."
@  9, 32  SAY  AUT
@ 11, 16  SAY "Orquesta........"
@ 11, 32  SAY  ORQ
@ 14, 34  SAY "LOCALIZACION"
@ 17, 18  SAY "Cassette No:         Lado:       Tema No:   "
@ 17, 31  SAY NUMERO
@ 17, 45  SAY LADO
@ 17, 60  SAY CANCION
CASE OPCION1=2
@  3, 13  TO 20, 66    DOUBLE
@ 13, 16  TO 18, 63
@ 15, 17  TO 15, 62
@  1, 16  SAY "REGISTRO Y LOCALIZACION DE BOLEROS"
@  5, 16  SAY "Titulo.........."
@  5, 32  GET  TIT
CLEAR GETS
@  7, 16  SAY "Interprete......"
@  7, 32  SAY  INT
@  9, 16  SAY "Autor..........."
@  9, 32  SAY  AUT
@ 11, 16  SAY "Orquesta........"
@ 11, 32  SAY  ORQ
@ 14, 34  SAY "LOCALIZACION"
@ 17, 18  SAY "Cassette No:         Lado:       Tema No:   "
@ 17, 31  SAY NUMERO
@ 17, 45  SAY LADO
@ 17, 60  SAY CANCION
CASE OPCION1=3
@  3, 13  TO 20, 66    DOUBLE
@ 13, 16  TO 18, 63
@ 15, 17  TO 15, 62
@  1, 16  SAY "REGISTRO Y LOCALIZACION DE BOLEROS"
@  5, 16  SAY "Titulo.........."
@  5, 32  SAY  TIT
@  7, 16  SAY "Interprete......"
@  7, 32  SAY  INT
@  9, 16  SAY "Autor..........."
@  9, 32  SAY  AUT
@ 11, 16  SAY "Orquesta........"
@ 11, 32  GET  ORQ
CLEAR GETS
@ 14, 34  SAY "LOCALIZACION"
@ 17, 18  SAY "Cassette No:         Lado:       Tema No:   "
@ 17, 31  SAY NUMERO
@ 17, 45  SAY LADO
@ 17, 60  SAY CANCION
ENDCASE
RETURN

